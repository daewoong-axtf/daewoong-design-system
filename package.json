{
  "name": "dw-design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "대웅 공용 디자인 시스템 — 언어 무관 토큰·컴포넌트 명세·HTML/CSS 레퍼런스",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:tokens": "node scripts/build-tokens.ts",
    "build:icons": "node scripts/build-icons.ts",
    "build:catalog": "node scripts/build-catalog.ts",
    "build": "pnpm build:tokens && pnpm build:icons && pnpm build:catalog",
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.json",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "shadcn": "shadcn",
    "test:storybook": "vitest run --config vitest.config.ts"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "~10.6.5",
    "@storybook/addon-docs": "~10.6.5",
    "@storybook/addon-vitest": "~10.6.5",
    "@storybook/react-vite": "~10.6.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "4.1.7",
    "playwright": "1.60.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.23.0",
    "storybook": "~10.6.5",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "4.1.7"
  },
  "packageManager": "pnpm@10.30.3",
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "1.66.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "~19.2.9",
    "react-dom": "~19.2.9",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
